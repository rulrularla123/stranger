  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.14",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
